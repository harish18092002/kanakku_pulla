# Copy to .env. Read ONLY through lib/config.ts; shell/global env vars are ignored.
# Leave a key empty to skip that provider (the server falls back to its rule-based mode).

# Comma-separated, tried in order. Unknown names are ignored ("none" disables AI).
AI_PROVIDER_ORDER=gemini,claude
# Per-provider timeout in milliseconds.
AI_TIMEOUT_MS=8000
# Longer timeout for the agent's live web search (Gemini + Google Search), which takes ~10-15s.
AI_SEARCH_TIMEOUT_MS=20000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

GCP_PROJECT_ID=kanakkupulla-513608
FIRESTORE_ENABLED=true
